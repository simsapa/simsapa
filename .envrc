# direnv: put this project's Qt on PATH when a shell enters the directory.
#
# Convenience only. The build does NOT depend on this file -- CMakeLists.txt
# resolves its own Qt and asserts the version. See docs/qt-kit-selection.md.
#
# Per-machine setup (not automatable from here):
#   1. install direnv and add its shell hook
#   2. run `direnv allow` in this directory
#
# Without those, this file is inert and everything still builds correctly.

# Re-run the hook when the declared Qt version changes, so a QT_LINUX bump takes
# effect without manually reloading the shell.
watch_file CMakeLists.txt
watch_file scripts/qt-env.sh

source scripts/qt-env.sh
