# Android release signing credentials for build-android.sh / `make android-aab`.
#
# Copy to android/signing.env (gitignored) and fill in the values:
#
#     cp android/signing.env.example android/signing.env
#
# These are the environment variables androiddeployqt's --sign reads. Anything
# already exported in your shell takes precedence over this file, so you can
# keep the passwords in a password manager and export them ad hoc instead.
#
# To look up the alias in an existing keystore:
#     keytool -list -v -keystore /full/path/to/simsapa-upload-keystore.jks

# /full/path/to/upload-keystore.jks
QT_ANDROID_KEYSTORE_PATH=CHANGE_ME
# e.g. simsapa-upload
QT_ANDROID_KEYSTORE_ALIAS=CHANGE_ME
# key password
QT_ANDROID_KEYSTORE_STORE_PASS=CHANGE_ME

# Only needed if the private key has a different password than the keystore.
# Left unset, build-android.sh reuses the store password.
#QT_ANDROID_KEYSTORE_KEY_PASS=CHANGE_ME
